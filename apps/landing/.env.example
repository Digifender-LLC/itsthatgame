# Copy to .env.local for local development. All values are public (they ship in the page).
# API origin of the Worker (no trailing slash). Default: local wrangler dev.
VITE_API_BASE=http://localhost:8787
# Cloudflare Turnstile site key. This default is Cloudflare's always-pass TEST key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Version of the privacy notice the consent checkbox refers to (must match privacy.html).
VITE_CONSENT_NOTICE_VERSION=2026-10-04
