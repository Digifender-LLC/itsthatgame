# Copy to .env.local for local overrides. Never commit real values (agents.md).
# Base URL of the API Worker (IF-2, IF-3). Defaults to http://127.0.0.1:8787 (wrangler dev).
VITE_API_BASE=
# RevenueCat public SDK keys (IF-4). Leave empty in dev: the browser uses the DevAdapter.
VITE_RC_IOS_KEY=
VITE_RC_ANDROID_KEY=
# Public pages linked from Settings and the paywall.
VITE_PRIVACY_URL=
VITE_TERMS_URL=
VITE_SUPPORT_URL=
# Debug/sideload builds only: "1" makes native builds use the no-charge sandbox unlock
# instead of RevenueCat. Never set for release builds (docs/release-checklist.md).
VITE_ALLOW_DEV_PURCHASES=
